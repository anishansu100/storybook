// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")       // transaction pooler — used by the app
    directUrl = env("DIRECT_URL")         // session pooler — used by prisma db push/migrate
}

model Story {
    id                String      @id @default(cuid())
    tripContext       String?
    status            StoryStatus @default(PENDING)
    uploadedImageUrls String[]
    createdByEmail    String?
    createdAt         DateTime    @default(now())
    updatedAt         DateTime    @updatedAt
    pages             StoryPage[]

    @@index([createdByEmail])
}

model AllowedEmail {
    id      String   @id @default(cuid())
    email   String   @unique
    addedAt DateTime @default(now())
    addedBy String
}

model AccessLog {
    id        String   @id @default(cuid())
    email     String
    action    String
    metadata  Json?
    createdAt DateTime @default(now())

    @@index([email])
    @@index([createdAt])
}

enum StoryStatus {
    PENDING
    GENERATING
    COMPLETE
    FAILED
}

model StoryPage {
    id                 String   @id @default(cuid())
    storyId            String
    story              Story    @relation(fields: [storyId], references: [id])
    pageNumber         Int
    narrative          String
    illustrationPrompt String
    illustrationUrl    String?
    createdAt          DateTime @default(now())

    @@index([storyId])
}
